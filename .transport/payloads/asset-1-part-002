    "url": "https://github.com/ud-tetra/UD/blob/9d5f9f354d36b8528fa20c86d7837d18d0edee1f/captures/2026-10-17T173305Z-codex-record-only-spectrum-fc6e3b97/RECORD_ONLY_THEOREMS.md",
