    "note": "Metadata indexed at pinned commit. File content is not necessarily read; Git blob SHA d2cdb2e1705dce39e05b670991ebb1aa81a6c176 Full available text is embedded; original claim/review scope remains unchanged.",
    "url": "https://github.com/ud-tetra/UD/blob/47121c4b2d8f472c4eaa977b475d20cc267eed3d/captures/2026-10-07T191951Z-codex-ud-bootstrap-5170f8b8/browse/dist/papers/UD_PAPER_III_CONSOLIDATED_DRAFT_v1.1.md",
    "local": "",
    "sha256": "",
