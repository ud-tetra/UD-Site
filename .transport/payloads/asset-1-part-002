    "url": "https://github.com/ud-tetra/UD/blob/9d5f9f354d36b8528fa20c86d7837d18d0edee1f/captures/2026-10-17T184000Z-codex-session-publication-7f4a2d91/reports/UD_37_INSTRUMENT_ERROR_CONTRACT_v0.1/UD_37_INSTRUMENT_ERROR_CONTRACT_v0.1.md",
