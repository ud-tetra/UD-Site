    "content": "#!/usr/bin/env python3\n\"\"\"Independent exact 12-state memory lift of the filled-K4 chain generator.\"\"\"\nimport itertools\nimport json\nfrom fractions import Fraction as F\n\nV=tuple(range(4))\nS=[list(itertools.combinations(V,k)) for k in (1,2,3,4)]\nO=(0,4,10,14)\ndef z(n,m): return [[F(0) for _ in range(m)] for _ in range(n)]\ndef eye(n):\n    x=z(n,n)\n    for i in range(n): x[i][i]=F(1)\n    return x\ndef tr(a): return [list(v) for v in zip(*a)]\ndef mul(a,b): return [[sum((a[i][k]*b[k][j] for k in range(len(b))),F(0))\n                       for j in range(len(b[0]))] for i in range(len(a))]\ndef add(a,b,sa=F(1),sb=F(1)):\n    return [[sa*x+sb*y for x,y in zip(ra,rb)] for ra,rb in zip(a,b)]\ndef boundary(a,b):\n    x=z(len(a),len(b)); ix={t:i for i,t in enumerate(a)}\n    for j,t in enumerate(b):\n        for k in range(len(t)): x[ix[t[:k]+t[k+1:]]][j]=F((-1)**k)\n    return x\ndef action(r,simplices):\n    x=z(len(simplices),len(simplices)); ix={t:i for i,t in enumerate(simplices)}\n    for j,t in enumerate(simplices):\n        image=tuple(r[v] for v in t)\n        inversions=sum(image[i]>image[k] for i in range(len(image)) for k in range(i+1,len(image)))\n        x[ix[tuple(sorted(image))]][j]=F((-1)**inversions)\n    return x\ndef main():\n    b1,b2,b3=[boundary(S[k],S[k+1]) for k in range(3)]\n    assert mul(b1,b2)==z(4,4) and mul(b2,b3)==z(6,1)\n    l1=add(mul(tr(b1),b1),mul(b2,tr(b2)))\n    assert l1==add(z(6,6),eye(6),sb=F(4))\n    a=z(15,15)\n    for k,b in enumerate((b1,b2,b3)):\n        for i in range(len(b)):\n            for j in range(len(b[0])):\n                a[O[k]+i][O[k+1]+j]=-b[i][j]\n                a[O[k+1]+j][O[k]+i]=b[i][j]\n    assert tr(a)==add(z(15,15),a,sb=F(-1))\n    # q=c1, p=q'=B1^T c0-B2 c2. This lift is the unique minimum-norm\n    # completion of p among c0,c2, with c3=0 and uniform c0=0.\n    lift=z(15,12)\n    for i in range(6): lift[4+i][i]=F(1)\n    for i in range(4):\n        for j in range(6): lift[i][6+j]=b1[i][j]/4\n    for i in range(4):\n        for j in range(6): lift[10+i][6+j]=-b2[j][i]/4\n    metric=z(12,12); gen=z(12,12)\n    for i in range(6):\n        metric[i][i]=F(1); metric[6+i][6+i]=F(1,4)\n        gen[i][6+i]=F(1); gen[6+i][i]=F(-4)\n    assert mul(tr(lift),lift)==metric\n    assert mul(a,lift)==mul(lift,gen)\n    assert add(mul(tr(gen),metric),mul(metric,gen))==z(12,12)\n    assert mul(mul(gen,gen),gen)==add(z(12,12),gen,sb=F(-4))\n    mq=z(12,12)\n    for i in range(6): mq[i][6+i]=F(1,2); mq[6+i][i]=F(-2)\n    mh=add(z(12,12),eye(12),sb=F(-1))\n    assert mul(mq,mq)==mh\n    assert mul(tr(mq),mul(metric,mq))==metric\n    inv_q=add(z(12,12),mq,sb=F(-1))\n    assert mul(inv_q,mq)==eye(12)\n    # The q-only 6-by-6 compression vanishes at a quarter-step, while its\n    # memory companion p records the six independent oriented edge probes.\n    assert [row[:6] for row in mq[:6]]==z(6,6)\n    assert [row[:6] for row in mq[6:]]==add(z(6,6),eye(6),sb=F(-2))\n    group=list(itertools.permutations(V)); reps=set()\n    for r in group:\n        rho=action(r,S[1])\n        full=z(15,15)\n        for k,simplices in enumerate(S):\n            block=action(r,simplices)\n            for i in range(len(block)):\n                for j in range(len(block)):\n                    full[O[k]+i][O[k]+j]=block[i][j]\n        rmem=z(12,12)\n        for k in (0,6):\n            for i in range(6):\n                for j in range(6): rmem[k+i][k+j]=rho[i][j]\n        assert mul(full,lift)==mul(lift,rmem)\n        assert mul(rmem,mq)==mul(mq,rmem)\n        # CONDITIONAL observed-frame fixture, not a frame generated by A:\n        # observed=rmem*intrinsic, co-moving=intrinsic.\n        residual=mul(mul(rmem,mq),inv_q)\n        assert residual==rmem\n        reps.add(tuple(map(tuple,residual)))\n    assert len(reps)==24\n    print(json.dumps({\"status\":\"EXACT native memory lift / conditional frame fixture\",\n      \"carrier\":\"C1 q plus source-derived C1 derivative p, 12-dimensional\",\n      \"lift\":\"c0=B1 p/4; c1=q; c2=-B2^T p/4; c3=0\",\n      \"evolution\":\"q'=p; p'=-4q\",\n      \"induced_metric\":\"diag(I6,I6/4)\",\"quarter_step\":\"(q,p)->(p/2,-2q)\",\n      \"quarter_step_invertible\":True,\"q_only_quarter_step\":\"zero 6x6\",\n      \"full_S4_conditional_frame_cases\":len(reps),\n      \"native_flow_selects_relative_frame\":False,\n      \"physical_promotion\":0},indent=2))\n\nif __name__==\"__main__\": main()\n"
