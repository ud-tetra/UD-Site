plus\",\"J_B\",\"s_B_other\"] if any(k not in req for k in required): return {\"status\":\"REJECT_MISSING_SOURCE_COMPLETE_FIELD\"} rm=[frac(x) for x in req[\"rho_minus\"]] rp=[frac(x) for x in req[\"rho_plus\"]] J=[frac(x) for x in req[\"J_B\"]] so=[frac(x) for x in req[\"s_B_other\"]] if not (len(rm)==len(rp)==len(J)==len(so)==4): return {\"status\":\"REJECT_DIMENSION\"} BJ=matvec(B,J) sw=[rp[i]-rm[i]-BJ[i]-so[i] for i in range(4)] eps=sum(sw,Fraction(0)) uniform=all(x==sw[0] for x in sw) result={ \"status\":\"PASS_SOURCE_EXTRACTION\" if uniform else \"NO_SCORE_NONUNIFORM_SOURCE\", \"event_id\":req.get(\"event_id\"), \"event_class\":\"E2\", \"transition\":\"2->3\", \"s_B_W\":[fstr(x) for x in sw], \"epsilon_2\":fstr(eps), \"uniform_mode_purity_exact\":uniform, \"incidence_total_BJ\":fstr(sum(BJ,Fraction(0))), \"physical_promotion\":0, } return result def leakage_ingestor(req): hits=check_forbidden(req,LEAKAGE_FORBIDDEN) if hits: return {\"status\":\"REJECT_FORBIDDEN_INPUT\",\"forbidden_paths\":hits} if req.get(\"event_class\")!=\"E2\" or req.get(\"transition\")!=\"2->3\": return {\"status\":\"REJECT_EVENT_CLASS\"} if \"Lambda_2\" not in req: return {\"status\":\"REJECT_MISSING_LAMBDA2\"} lam=frac(req[\"Lambda_2\"]) return { \"status\":\"PASS_INDEPENDENT_LEAKAGE_RETURN\", \"event_id\":req.get(\"event_id\"), \"event_class\":\"E2\", \"transition\":\"2->3\", \"Lambda_2\":fstr(lam), \"provider_provenance\":req.get(\"provider_provenance\",\"UNDECLARED\"), \"physical_promotion\":0 } def canonical_hash(obj): b=json.dumps(obj,sort_keys=True,separators=(\",\",\":\")).encode() return hashlib.sha256(b).hexdigest() def main(): ap=argparse.ArgumentParser() ap.add_argument(\"mode\",choices=[\"burden\",\"leakage\"]) ap.add_argument(\"request\") ap.add_argument(\"--out\",required=True) a=ap.parse_args() req=json.loads(Path(a.request).read_text()) res=burden_provider(req) if a.mode==\"burden\" else leakage_ingestor(req) res[\"request_sha256\"]=canonical_hash(req) res[\"return_sha256