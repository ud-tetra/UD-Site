    "size_bytes": 0,
    "content": "Transforms the declared alternate time-trace source into the temporal triplet carrier required for preregistered replay. #!/usr/bin/env python3\n\"\"\"Target-blind TTRTS adapter for already-digitized RTS bits.\n\nRaw-current classification is intentionally separate because D1488 archive bytes were not\nmaterialized in this runtime. This module starts after calibration-only thresholding and\nresampling have produced one ordered bit stream per native held-out run.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\ndef temporal_triplets(bits, run_id):\n    bits=np.asarray(bits,dtype=int)\n    if not np.isin(bits,[0,1]).all():\n        raise ValueError(\"non-binary source bit\")\n    nB=len(bits)//3\n    if nB<2:\n        raise ValueError(\"insufficient triplets\")\n    B=bits[:3*nB].reshape(nB,3)\n    A=B[:-1]^B[1:]\n    Bout=B[1:]\n    return pd.DataFrame({\n        \"run_id\":run_id,\n        \"event_id\":np.arange(1,nB),\n        \"A1\":A[:,0],\"A2\":A[:,1],\"A3\":A[:,2],\n        \"B1\":Bout[:,0],\"B2\":Bout[:,1],\"B3\":Bout[:,2],\n        \"physical_source_status\":\"CAPTURED\"\n    })\n\ndef resample_binary(native_bits, q, phase=0):\n    if q < 1:\n        raise ValueError(\"q must be positive\")\n    if phase != 0:\n        raise ValueError(\"v0.1 freezes phase=0\")\n    return np.asarray(native_bits,dtype=int)[phase::q]\n\nif __name__==\"__main__\":\n    # Deterministic example only.\n    b=np.array([0,1,1, 1,1,0, 1,0,0, 0,0,1])\n    print(temporal_triplets(b,\"example\").to_csv(index=False))\n"
