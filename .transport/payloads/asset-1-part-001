    "content": "Reference implementation for source-populated covariance propagation; it does not invent metrology values or authorize a numerical pass band. \"\"\"\nUD Córdoba Comparator Uncertainty Engine v0.1\nSymbolic / pretarget. No instrument accuracy defaults are supplied.\nPhysical promotion: 0.\n\"\"\"\nfrom math import sqrt\n\nAREAS_CM2 = {\"A1\":316.82, \"A2\":316.82, \"A3\":184.29, \"A4\":184.29}\n\ndef r14(dm1, dm2, dm3, dm4, dfL, dfR, A1=316.82, A2=316.82, A3=184.29, A4=184.29):\n    return 0.25*(A1*dm1 - A2*dm2 - A3*dm3 + A4*dm4 - dfL + dfR)\n\ndef fixed_area_variance(cov6, A1=316.82, A2=316.82, A3=184.29, A4=184.29):\n    \"\"\"cov6 order: dm1,dm2,dm3,dm4,dfL,dfR.\"\"\"\n    j = [A1/4, -A2/4, -A3/4, A4/4, -1/4, 1/4]\n    return sum(j[i]*cov6[i][k]*j[k] for i in range(6) for k in range(6))\n\ndef first_order_variance(cov10, values):\n    \"\"\"\n    cov10 order: A1,A2,A3,A4,dm1,dm2,dm3,dm4,dfL,dfR\n    values requires A1..A4, dm1..dm4.\n    \"\"\"\n    j = [\n        values[\"dm1\"]/4, -values[\"dm2\"]/4, -values[\"dm3\"]/4, values[\"dm4\"]/4,\n        values[\"A1\"]/4, -values[\"A2\"]/4, -values[\"A3\"]/4, values[\"A4\"]/4,\n        -1/4, 1/4\n    ]\n    return sum(j[i]*cov10[i][k]*j[k] for i in range(10) for k in range(10))\n\ndef independent_product_variance(values, u):\n    \"\"\"\n    Exact under independence of each A_i and dm_i, and independence across all terms.\n    u entries are standard uncertainties matching values.\n    \"\"\"\n    total = 0.0\n    for i in range(1,5):\n        A = values[f\"A{i}\"]\n        dm = values[f\"dm{i}\"]\n        uA = u[f\"A{i}\"]\n        udm = u[f\"dm{i}\"]\n        total += A*A*udm*udm + dm*dm*uA*uA + uA*uA*udm*udm\n    total += u[\"dfL\"]**2 + u[\"dfR\"]**2\n    return total/16.0\n\ndef ols_slope(times, levels):\n    n = len(times)\n    if n != len(levels) or n < 2:\n        raise ValueError(\"times/levels length mismatch or insufficient samples\")\n    tb = sum(times)/n\n    S = sum((t-tb)**2 for t in times)\n    if S == 0:\n        raise ValueError(\"zero time spread\")\n    return sum((t-tb)*h for t,h in zip(times,levels))/S\n\ndef ols_level_weights(times):\n    n=len(times)\n    tb=sum(times)/n\n    S=sum((t-tb)**2 for t in times)\n    return [(t-tb)/S for t in times]\n\ndef hard_bound(Ahat, dmhat, B_A, B_dm, B_dfL, B_dfR):\n    \"\"\"\n    Distribution-free product/error bound.\n    dictionaries keyed A1..A4 and dm1..dm4.\n    \"\"\"\n    total = B_dfL + B_dfR\n    for i in range(1,5):\n        total += (\n            abs(Ahat[f\"A{i}\"])*B_dm[f\"dm{i}\"]\n            + abs(dmhat[f\"dm{i}\"])*B_A[f\"A{i}\"]\n            + B_A[f\"A{i}\"]*B_dm[f\"dm{i}\"]\n        )\n    return total/4.0\n"
