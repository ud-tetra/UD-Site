    "size_bytes": 0,
    "content": "Executable scoring implementation for the preregistered comparison. Code and synthetic execution are not hardware evidence. #!/usr/bin/env python3\nimport json, math, sys\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.optimize import minimize_scalar\nfrom scipy.stats import chi2\n\nN_REQUIRED=24\nN_EACH=12\nN_BLOCKS=6\nALPHA_ABS=0.01\nDELTA_AICC_STRONG=10.0\nK_PARAMS=1\nD_H={'E0':0.25,'E1':0.75}\n\ndef _num(x,name):\n    try:\n        v=float(x)\n    except Exception:\n        raise ValueError(f'{name} must be numeric')\n    if not math.isfinite(v):\n        raise ValueError(f'{name} must be finite')\n    return v\n\ndef _weighted_mean(vals, sigmas):\n    vals=np.asarray(vals,float); sigmas=np.asarray(sigmas,float)\n    w=1.0/(sigmas**2)\n    m=float(np.sum(w*vals)/np.sum(w))\n    u=float(math.sqrt(1.0/np.sum(w)))\n    return m,u\n\ndef _validate(data):\n    if not data.get('channel_independence_confirmed',False):\n        return 'NO_SCORE_CHANNEL_INDEPENDENCE_FAIL',None\n    if not data.get('custody_frozen',False):\n        return 'NO_SCORE_CUSTODY_NOT_FROZEN',None\n    if not data.get('uncertainty_model_complete',False):\n        return 'NO_SCORE_UNCERTAINTY_MODEL_INCOMPLETE',None\n    runs=data.get('runs')\n    if not isinstance(runs,list):\n        return 'NO_SCORE_SOURCE_INCOMPLETE',None\n    primary=[r for r in runs if r.get('valid_primary') is True]\n    if len(primary)!=N_REQUIRED:\n        return 'NO_SCORE_PRIMARY_SET_INCOMPLETE',{'valid_primary_count':len(primary)}\n    ids=[r.get('blind_run_id') for r in primary]\n    if None in ids or len(set(ids))!=len(ids):\n        return 'NO_SCORE_DUPLICATE_OR_MISSING_RUN_ID',None\n    for r in primary:\n        if r.get('event_id') not in ('E0','E1'):\n            return 'NO_SCORE_EVENT_LABEL_INVALID',None\n        if not r.get('calibration_in_control',False):\n            return 'NO_SCORE_CALIBRATION_GATE_FAIL',{'blind_run_id':r.get('blind_run_id')}\n        if not r.get('source_purity_pass',False):\n            return 'NO_SCORE_SOURCE_PURITY_FAIL',{'blind_run_id':r.get('blind_run_id')}\n        try:\n            r['_epsilon']=_num(r.get('epsilon'),'epsilon')\n            r['_ue']=_num(r.get('u_epsilon'),'u_epsilon')\n            r['_lambda']=_num(r.get('Lambda'),'Lambda')\n            r['_ul']=_num(r.get('u_Lambda'),'u_Lambda')\n            r['_cov']=_num(r.get('cov_epsilon_lambda'),'cov_epsilon_lambda')\n            r['_block']=int(r.get('block'))\n        except Exception as exc:\n            return 'NO_SCORE_SOURCE_INCOMPLETE',{'error':str(exc),'blind_run_id':r.get('blind_run_id')}\n        if r['_ue']<=0 or r['_ul']<0:\n            return 'NO_SCORE_UNCERTAINTY_INVALID',{'blind_run_id':r.get('blind_run_id')}\n    counts={e:sum(r['event_id']==e for r in primary) for e in ('E0','E1')}\n    if counts!={'E0':N_EACH,'E1':N_EACH}:\n        return 'NO_SCORE_EVENT_BALANCE_FAIL',counts\n    blocks=sorted(set(r['_block'] for r in primary))\n    if blocks!=list(range(1,N_BLOCKS+1)):\n        return 'NO_SCORE_BLOCK_STRUCTURE_FAIL',{'blocks':blocks}\n    for b in blocks:\n        bc={e:sum(r['_block']==b and r['event_id']==e for r in primary) for e in ('E0','E1')}\n        if bc!={'E0':2,'E1':2}:\n            return 'NO_SCORE_BLOCK_BALANCE_FAIL',{'block':b,'counts':bc}\n    b_units={r.get('burden_units') for r in primary}; l_units={r.get('leakage_units') for r in primary}\n    if len(b_units)!=1 or None in b_units:\n        return 'NO_SCORE_BURDEN_UNITS_MISMATCH',{'units':list(b_units)}\n    if len(l_units)!=1 or None in l_units:\n        return 'NO_SCORE_LEAKAGE_UNITS_MISMATCH',{'units':list(l_units)}\n    return None,primary\n\ndef _nll_H(k,y,ue,d):\n    v=ue**2\n    r=y-k*d\n    return 0.5*float(np.sum(np.log(2*np.pi*v)+(r*r)/v))\n\ndef _fit_H(y,ue,d):\n    w=1/(ue**2)\n    den=float(np.sum(w*d*d))\n    if den<=0: raise ValueError('H denominator zero')\n    k=float(np.sum(w*d*y)/den)\n    nll=_nll_H(k,y,ue,d)\n    v=ue**2; res=y-k*d\n    chi=float(np.sum(res*res/v))\n    return k,nll,chi,res,v\n\ndef _fit_P(y,ue,x,ux,cov):\n    sy=max(float(np.max(np.abs(y))),float(np.max(ue)),1e-12)\n    sx=max(float(np.max(np.abs(x))),float(np.max(ux)),1e-12)\n    scale=sy/sx\n    bound=max(1000.0*scale,1e-9)\n    def nll(k):\n        v=ue**2+(k*k)*(ux**2)-2*k*cov\n        if np.any(v<=0) or np.any(~np.isfinite(v)):\n            return 1e300\n        r=y-k*x\n        return 0.5*float(np.sum(np.log(2*np.pi*v)+(r*r)/v))\n    opt=minimize_scalar(nll,bounds=(-bound,bound),method='bounded',options={'xatol':1e-12,'maxiter':2000})\n    if not opt.success or not math.isfinite(opt.fun):\n        raise ValueError('PLB1 optimizer failed')\n    k=float(opt.x)\n    v=ue**2+(k*k)*(ux**2)-2*k*cov\n    if np.any(v<=0): raise ValueError('PLB1 propagated variance nonpositive')\n    res=y-k*x\n    chi=float(np.sum(res*res/v))\n    boundary=abs(k)>=0.999*bound\n    return k,float(opt.fun),chi,res,v,bound,boundary\n\ndef _aicc(nll,n,k=1):\n    if n<=k+1: return float('inf')\n    return 2*nll+2*k+(2*k*(k+1))/(n-k-1)\n\ndef score(data):\n    status,primary=_validate(data)\n    if status:\n        out={'status':status,'physical_promotion':0}\n        if isinstance(primary,dict): out.update(primary)\n        return out\n    y=np.array([r['_epsilon'] for r in primary],float)\n    ue=np.array([r['_ue'] for r in primary],float)\n    x=np.array([r['_lambda'] for r in primary],float)\n    ux=np.array([r['_ul'] for r in primary],float)\n    cov=np.array([r['_cov'] for r in primary],float)\n    d=np.array([D_H[r['event_id']] for r in primary],float)\n    try:\n        kH,nllH,chiH,resH,vH=_fit_H(y,ue,d)\n        kP,nllP,chiP,resP,vP,bound,boundary=_fit_P(y,ue,x,ux,cov)\n    except Exception as exc:\n        return {'status':'NO_SCORE_NUMERICAL_FAILURE','error':str(exc),'physical_promotion':0}\n    if boundary:\n        return {'status':'NO_SCORE_NUMERICAL_BOUNDARY','kappa_P':kP,'search_bound':bound,'physical_promotion':0}\n    df=len(primary)-K_PARAMS\n    pH=float(chi2.sf(chiH,df)); pP=float(chi2.sf(chiP,df))\n    aH=_aicc(nllH,len(primary),K_PARAMS); aP=_aicc(nllP,len(primary),K_PARAMS)\n    delta=float(aP-aH)\n    fitH=pH>=ALPHA_ABS; fitP=pP>=ALPHA_ABS\n    if fitH and delta>=DELTA_AICC_STRONG:\n        verdict='HCB1_PASS_EMPIRICAL_SCOPED'\n    elif fitP and delta<=-DELTA_AICC_STRONG:\n        verdict='PLB1_PASS_EMPIRICAL_SCOPED'\n    elif (not fitH) and (not fitP):\n        verdict='NEITHER_SIMPLE_BRIDGE'\n    else:\n        verdict='EMPIRICAL_INDETERMINATE'\n    # Diagnostics by class\n    cls={}\n    for e in ('E0','E1'):\n        rr=[r for r in primary if r['event_id']==e]\n        em,eu=_weighted_mean([r['_epsilon'] for r in rr],[r['_ue'] for r in rr])\n        # leakage mean uses positive u; if exact zero uncertainties all, arithmetic mean and u=0\n        lus=[r['_ul'] for r in rr]\n        if all(u>0 for u in lus):\n            lm,lu=_weighted_mean([r['_lambda'] for r in rr],lus)\n        else:\n            lm=float(np.mean([r['_lambda'] for r in rr])); lu=0.0\n        cls[e]={'epsilon_mean':em,'u_epsilon_mean':eu,'Lambda_mean':lm,'u_Lambda_mean':lu}\n    RB=None; RL=None; zL=None\n    if cls['E0']['epsilon_mean']!=0:\n        RB=cls['E1']['epsilon_mean']/cls['E0']['epsilon_mean']\n    if cls['E0']['Lambda_mean']!=0:\n        RL=cls['E1']['Lambda_mean']/cls['E0']['Lambda_mean']\n    denom=math.sqrt(cls['E0']['u_Lambda_mean']**2+cls['E1']['u_Lambda_mean']**2)\n    if denom>0: zL=(cls['E1']['Lambda_mean']-cls['E0']['Lambda_mean'])/denom\n    per=[]\n    for i,r in enumerate(primary):\n        per.append({\n            'blind_run_id':r['blind_run_id'],'block':r['_block'],'event_id':r['event_id'],\n            'z_PLB1':float(resP[i]/math.sqrt(vP[i])),\n            'z_HCB1':float(resH[i]/math.sqrt(vH[i]))\n        })\n    return {\n        'status':verdict,\n        'n':len(primary),'df_gof':df,\n        'protocol':{'alpha_absolute_fit':ALPHA_ABS,'strong_delta_AICc':DELTA_AICC_STRONG,'fitted_parameters_per_model':1,'extra_scatter_fitted':False},\n        'PLB1':{'kappa_hat':kP,'NLL':nllP,'chi2':chiP,'p_gof':pP,'absolute_fit_pass':fitP,'AICc':aP},\n        'HCB1':{'kappa_hat':kH,'NLL':nllH,'chi2':chiH,'p_gof':pH,'absolute_fit_pass':fitH,'AICc':aH},\n        'delta_AICc_P_minus_H':delta,\n        'class_diagnostics':cls,\n        'R_B_weighted_means':RB,'R_Lambda_weighted_means':RL,'leakage_stationarity_z':zL,\n        'run_standardized_residuals':per,\n        'physical_promotion':0\n    }\n\nif __name__=='__main__':\n    if len(sys.argv)!=2:\n        raise SystemExit('usage: empirical_joint_source_event_scorer_v0.2.py input.json')\n    print(json.dumps(score(json.loads(Path(sys.argv[1]).read_text())),indent=2,sort_keys=True))\n"
