    "content": "Verifies local release archives and every file listed by their package manifests against the machine-readable authority snapshot. #!/usr/bin/env python3\n\"\"\"Verify a local mirror against UD_RELEASE_AUTHORITY_MANIFEST_v0.1.json.\"\"\"\n\nimport hashlib\nimport json\nimport re\nimport sys\nfrom pathlib import Path\n\n\ndef digest(path: Path) -> str:\n    h = hashlib.sha256()\n    with path.open(\"rb\") as stream:\n        for chunk in iter(lambda: stream.read(1024 * 1024), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef entries(path: Path):\n    if path.suffix == \".json\":\n        data = json.loads(path.read_text(encoding=\"utf-8\"))\n        for item in data.get(\"files\", []):\n            yield item.get(\"path\") or item.get(\"filename\") or item.get(\"file\"), item[\"sha256\"], item.get(\"bytes\")\n    else:\n        for line in path.read_text(encoding=\"utf-8\").splitlines():\n            match = re.match(r\"^([0-9a-f]{64})\\s+\\*?(.*)$\", line.strip())\n            if match:\n                yield match.group(2), match.group(1), None\n\n\ndef main() -> int:\n    if len(sys.argv) != 3:\n        print(\"usage: verify_ud_release_authority.py MANIFEST_JSON MIRROR_DIR\", file=sys.stderr)\n        return 2\n    authority = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))\n    mirror = Path(sys.argv[2])\n    failures = []\n    for release in authority[\"releases\"]:\n        archive = mirror / \"releases\" / release[\"archive\"]\n        if not archive.is_file():\n            failures.append(f\"missing archive: {archive}\")\n            continue\n        if archive.stat().st_size != release[\"bytes\"] or digest(archive) != release[\"sha256\"]:\n            failures.append(f\"archive mismatch: {release['archive']}\")\n            continue\n        outer = mirror / \"release_extract\" / archive.stem\n        children = list(outer.iterdir()) if outer.is_dir() else []\n        roots = [p for p in children if p.is_dir()]\n        root = roots[0] if len(roots) == 1 and not any(p.is_file() for p in children) else outer\n        manifest = root / release[\"manifest\"]\n        if not manifest.is_file():\n            failures.append(f\"missing package manifest: {release['archive']}\")\n            continue\n        for relpath, expected, expected_bytes in entries(manifest):\n            item = root / relpath\n            if not item.is_file() or digest(item) != expected:\n                failures.append(f\"listed-file mismatch: {release['archive']}::{relpath}\")\n            elif expected_bytes is not None and item.stat().st_size != expected_bytes:\n                failures.append(f\"listed-file size mismatch: {release['archive']}::{relpath}\")\n    if failures:\n        print(\"FAIL\")\n        print(\"\\n\".join(failures))\n        return 1\n    print(f\"PASS: {len(authority['releases'])} archives and all listed package hashes verified\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"
