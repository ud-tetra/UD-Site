    "title": "Empirical Joint Source-Event Scorer",
    "group": "Portal research catalog",
    "status": "SOURCE LABEL",
    "note": "Frozen reference code · v0.2 · Searchable source text imported; claim status is not re-adjudicated.",
    "url": "https://tetrahedral-packet-complexes.ben-w-mayes.chatgpt.site/#/doc/empiricalScorerCode",
