    "size_bytes": 0,
    "content": "Executable implementation of the frozen temporal and address-null correspondence test; code availability is not an empirical outcome. #!/usr/bin/env python3\nimport argparse,json\nimport numpy as np,pandas as pd\n\nALPHA=1/600\nN_COND=9999\nSEED=20260910\n\ndef _validate(ud,ph):\n    uc=[\"event_id\",\"a1\",\"a2\",\"a3\",\"theta1\",\"theta2\",\"theta3\",\"ud_source_status\"]\n    pc=[\"event_id\",\"A1\",\"A2\",\"A3\",\"B1\",\"B2\",\"B3\",\"physical_source_status\"]\n    if list(ud.columns)!=uc or list(ph.columns)!=pc: raise ValueError(\"schema mismatch\")\n    if ud.event_id.duplicated().any() or ph.event_id.duplicated().any(): raise ValueError(\"duplicate event_id\")\n    if ud.event_id.tolist()!=ph.event_id.tolist(): raise ValueError(\"event alignment mismatch\")\n    if not (ud.ud_source_status==\"RESOLVED\").all(): raise ValueError(\"unresolved UD event\")\n    if not (ph.physical_source_status==\"CAPTURED\").all(): raise ValueError(\"uncaptured physical event\")\n    for c in uc[1:7]:\n        if not set(ud[c].astype(int)).issubset({0,1}): raise ValueError(\"nonbinary UD\")\n    for c in pc[1:7]:\n        if not set(ph[c].astype(int)).issubset({0,1}): raise ValueError(\"nonbinary physical\")\n\ndef _stats(U,P):\n    ma=np.all(U[:,:3]==P[:,:3],axis=1)\n    mb=np.all(U[:,3:]==P[:,3:],axis=1)\n    return np.array([np.sum(ma&mb),np.sum(ma),np.sum(mb)],dtype=int)\n\ndef score(ud_path,ph_path,guard):\n    ud=pd.read_csv(ud_path); ph=pd.read_csv(ph_path); _validate(ud,ph)\n    U=ud[[\"a1\",\"a2\",\"a3\",\"theta1\",\"theta2\",\"theta3\"]].astype(int).to_numpy()\n    P=ph[[\"A1\",\"A2\",\"A3\",\"B1\",\"B2\",\"B3\"]].astype(int).to_numpy()\n    N=len(U); obs=_stats(U,P)\n\n    shifts=[d for d in range(1,N) if min(d,N-d)>guard]\n    if len(shifts)+1<600:\n        return {\"verdict\":\"INSUFFICIENT_NULL_RESOLUTION\",\"N\":N,\"allowed_shifts\":len(shifts)}\n    nt=np.array([_stats(U,np.roll(P,d,axis=0)) for d in shifts],dtype=int)\n    pT=[(1+int(np.sum(nt[:,j]>=obs[j])))/(1+len(shifts)) for j in range(3)]\n\n    shells=np.column_stack([P[:,:3].sum(axis=1),P[:,3:].sum(axis=1)])\n    strata={}\n    for i,h in enumerate(map(tuple,shells)):\n        strata.setdefault(h,[]).append(i)\n\n    rng=np.random.default_rng(SEED)\n    ge=np.zeros(3,dtype=int)\n    for _ in range(N_COND):\n        Q=P.copy()\n        for ids in strata.values():\n            if len(ids)>1:\n                ids=np.array(ids,dtype=int)\n                src=ids.copy()\n                rng.shuffle(src)\n                Q[ids]=P[src]\n        s=_stats(U,Q)\n        ge += (s>=obs)\n    pH=[(1+int(ge[j]))/(N_COND+1) for j in range(3)]\n\n    allp=pT+pH\n    if all(p<=ALPHA for p in allp):\n        verdict=\"ST3S_CORRESPONDENCE_PASS\"\n    elif all(p<=ALPHA for p in pT) and not all(p<=ALPHA for p in pH):\n        verdict=\"ST3S_SHELL_ONLY\"\n    else:\n        verdict=\"ST3S_NO_CORRESPONDENCE\"\n\n    return {\n        \"verdict\":verdict,\"N\":N,\"guard\":guard,\"allowed_shifts\":len(shifts),\n        \"conditional_randomizations\":N_COND,\"seed\":SEED,\n        \"alpha_familywise\":1/100,\"alpha_each\":ALPHA,\n        \"observed\":{\"S_AB\":int(obs[0]),\"S_A\":int(obs[1]),\"S_B\":int(obs[2])},\n        \"p_temporal\":{\"AB\":pT[0],\"A\":pT[1],\"B\":pT[2]},\n        \"p_shell_conditioned_address\":{\"AB\":pH[0],\"A\":pH[1],\"B\":pH[2]}\n    }\n\nif __name__==\"__main__\":\n    ap=argparse.ArgumentParser()\n    ap.add_argument(\"--ud\",required=True);ap.add_argument(\"--physical\",required=True)\n    ap.add_argument(\"--guard\",required=True,type=int);ap.add_argument(\"--out\",required=True)\n    a=ap.parse_args()\n    r=score(a.ud,a.physical,a.guard)\n    with open(a.out,\"w\") as f:json.dump(r,f,indent=2)\n    print(json.dumps(r,indent=2))\n"
