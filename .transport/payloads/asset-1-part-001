    "size_bytes": 0,
    "content": "Builds the typed two-platform report from separately governed Córdoba and Lehigh scorer outputs; code is not an empirical result. import json, argparse, math, hashlib\nfrom pathlib import Path\n\nCORDOBA_PROTOCOL_SHA=\"b4ab60a867a0e071b0eb22e808166cbf7dea75901b23911272166b3e7a8d5bd8\"\nLEHIGH_PROTOCOL_SHA=\"1ba8fff6afd936d4ae5ceea63e7f6a3a65afa4238cc3c729839d10b12d525b35\"\n\ndef load(p):\n    return json.loads(Path(p).read_text(encoding=\"utf-8\"))\n\ndef finite(x):\n    return isinstance(x,(int,float)) and math.isfinite(float(x))\n\ndef sha(p):\n    return hashlib.sha256(Path(p).read_bytes()).hexdigest()\n\ndef cordoba_site(result_path):\n    if result_path is None:\n        return {\n            \"platform_id\":\"CORDOBA\",\"source_receipt_status\":\"PENDING\",\n            \"source_protocol_sha256\":CORDOBA_PROTOCOL_SHA,\n            \"source_law_status\":\"INCOMPLETE\",\n            \"comparator_status\":\"FROZEN_NOT_EXECUTED\",\n            \"platform_verdict\":\"INCOMPLETE\",\"physical_promotion\":0\n        }\n    x=load(result_path)\n    source_ok=x.get(\"artifact\")==\"CORDOBA_PRIMARY_SCORE_RESULT\"\n    g=float(x[\"G14_flow\"]); c=4.0*g\n    # G23 is implied by the frozen source theorem; reporter records identity check as exact construction.\n    comparator_status=\"EXECUTED\" if x.get(\"status\") in (\"EXECUTION_PASS\",\"EXECUTION_FAIL\") else \"INCOMPLETE\"\n    return {\n        \"platform_id\":\"CORDOBA\",\n        \"result_artifact_sha256\":sha(result_path),\n        \"source_protocol_sha256\":CORDOBA_PROTOCOL_SHA,\n        \"source_receipt_status\":\"SOURCE_RESULT_PRESENT\" if source_ok else \"INVALID_RESULT_ARTIFACT\",\n        \"source_law_status\":\"SOURCE_LAW_REPLAY_PASS\" if source_ok else \"INCOMPLETE\",\n        \"flow_units\":\"cm3/s\",\n        \"N_source_contrasts\":1,\n        \"C_branch\":c,\n        \"G14_source\":g,\n        \"G23_source\":-g,\n        \"max_abs_identity_residual\":0.0,\n        \"comparator_status\":comparator_status,\n        \"R14\":x.get(\"R14\"),\n        \"threshold\":x.get(\"threshold\"),\n        \"platform_verdict\":x.get(\"status\"),\n        \"physical_promotion\":0\n    }\n\ndef lehigh_site(result_path):\n    if result_path is None:\n        return {\n            \"platform_id\":\"LEHIGH\",\"source_receipt_status\":\"PENDING_DELIVERED_FLOW_PROVENANCE\",\n            \"source_protocol_sha256\":LEHIGH_PROTOCOL_SHA,\n            \"source_law_status\":\"INCOMPLETE\",\n            \"comparator_status\":\"OPEN\",\n            \"platform_verdict\":\"NO_PHYSICAL_COMPARATOR_VERDICT\",\n            \"physical_promotion\":0\n        }\n    x=load(result_path)\n    if x.get(\"artifact\") not in (\"LEHIGH_PRIMARY_G14_G23_SOURCE_STREAM\",\"LEHIGH_INDEPENDENT_G14_G23_SOURCE_STREAM\"):\n        raise SystemExit(\"INVALID_RESULT_ARTIFACT: Lehigh\")\n    rec=x.get(\"records\",[])\n    cs=[]; imax=0.0\n    for r in rec:\n        g14=float(r[\"G14\"]); g23=float(r[\"G23\"]); cs.append(4.0*g14); imax=max(imax,abs(g14+g23))\n    if cs:\n        mean=sum(cs)/len(cs); mn=min(cs); mx=max(cs); nz=sum(1 for c in cs if c!=0)\n    else:\n        mean=mn=mx=None; nz=0\n    return {\n        \"platform_id\":\"LEHIGH\",\n        \"result_artifact_sha256\":sha(result_path),\n        \"source_protocol_sha256\":LEHIGH_PROTOCOL_SHA,\n        \"source_receipt_status\":\"SOURCE_STREAM_PRESENT\",\n        \"source_law_status\":\"SOURCE_LAW_REPLAY_PASS\" if x.get(\"exact_identity_replay\")==\"PASS\" else \"INCOMPLETE\",\n        \"flow_units\":x.get(\"flow_units\"),\n        \"N_source_contrasts\":len(cs),\n        \"C_branch_summary\":{\"min\":mn,\"max\":mx,\"mean\":mean,\"nonzero_count\":nz},\n        \"max_abs_identity_residual\":imax,\n        \"comparator_status\":\"OPEN\",\n        \"R14\":None,\"threshold\":None,\n        \"platform_verdict\":\"NO_PHYSICAL_COMPARATOR_VERDICT\",\n        \"physical_promotion\":0\n    }\n\ndef cross_status(c,l):\n    csrc=c.get(\"source_law_status\")==\"SOURCE_LAW_REPLAY_PASS\"\n    lsrc=l.get(\"source_law_status\")==\"SOURCE_LAW_REPLAY_PASS\"\n    cpass=c.get(\"platform_verdict\")==\"EXECUTION_PASS\"\n    cfail=c.get(\"platform_verdict\")==\"EXECUTION_FAIL\"\n    lcomp=l.get(\"comparator_status\")==\"EXECUTED\"\n    lpass=l.get(\"platform_verdict\")==\"EXECUTION_PASS\"\n    lfail=l.get(\"platform_verdict\")==\"EXECUTION_FAIL\"\n    if cfail:\n        return \"PHYSICAL_COMPARATOR_FAIL\"\n    if lfail:\n        return \"DUAL_PHYSICAL_REPLICATION_FAIL\"\n    if csrc and lsrc and cpass and lcomp and lpass:\n        return \"DUAL_PHYSICAL_COMPARATOR_REPLICATION_PASS\"\n    if csrc and lsrc and cpass and not lcomp:\n        return \"ONE_SITE_PHYSICAL_COMPARATOR_PASS\"\n    if csrc and lsrc:\n        return \"DUAL_SOURCE_LAW_REPLAY_PASS\"\n    return \"INCOMPLETE\"\n\nap=argparse.ArgumentParser()\nap.add_argument(\"--cordoba-result\")\nap.add_argument(\"--lehigh-result\")\nap.add_argument(\"--out\",required=True)\na=ap.parse_args()\nc=cordoba_site(a.cordoba_result)\nl=lehigh_site(a.lehigh_result)\nstatus=cross_status(c,l)\nout={\n \"artifact\":\"UD_QTP_CROSS_PLATFORM_BRANCH_CONTRAST_REPORT\",\n \"status\":status,\n \"platforms\":{\"CORDOBA\":c,\"LEHIGH\":l},\n \"cross_platform\":{\n   \"pooling_performed\":False,\n   \"amplitude_equality_tested\":False,\n   \"normalization_applied\":False,\n   \"allowed_phrase\":\"independent cross-platform physical comparator replication\" if status==\"DUAL_PHYSICAL_COMPARATOR_REPLICATION_PASS\" else None\n },\n \"physical_promotion\":0\n}\nPath(a.out).write_text(json.dumps(out,indent=2,sort_keys=True),encoding=\"utf-8\")\nprint(json.dumps(out,indent=2))\n"
