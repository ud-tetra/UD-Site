    "content": "Run within the complete package with its dependencies. #!/usr/bin/env python3\n\"\"\"Exact candidate-interface checks. Standard library only; no physical data.\"\"\"\nimport sys,json\nfrom pathlib import Path\nfrom itertools import combinations,permutations\nfrom collections import Counter\nsys.path.insert(0,str(Path(__file__).parent/'dependencies'))\nfrom shape_helpers import Q,mm,tr,plus,scale,diag,zero,sub,dot,boundary,encode\n\nchecks=[]\ndef check(label,value):\n    if not value:raise AssertionError(label)\n    checks.append(label)\ndef rank(a):\n    a=[[Q(v) for v in row] for row in a];i=0\n    for j in range(len(a[0])):\n        pivot=next((k for k in range(i,len(a)) if a[k][j]),None)\n        if pivot is None:continue\n        a[i],a[pivot]=a[pivot],a[i];p=a[i][j];a[i]=[v/p for v in a[i]]\n        for k in range(len(a)):\n            if k!=i:\n                f=a[k][j];a[k]=[v-f*w for v,w in zip(a[k],a[i])]\n        i+=1\n        if i==len(a):break\n    return i\ndef det(a):\n    n=len(a);value=Q(0)\n    for p in permutations(range(n)):\n        inversions=sum(p[i]>p[j] for i in range(n) for j in range(i+1,n))\n        term=Q((-1)**inversions)\n        for i,j in enumerate(p):term*=a[i][j]\n        value+=term\n    return value\ndef vertices(r):return [[Q(1),Q(1),r],[Q(1),Q(-1),-r],[Q(-1),Q(1),-r],[Q(-1),Q(-1),r]]\nS={k:list(combinations(range(4),k+1)) for k in range(4)}\nB={k:boundary(k,S) for k in range(1,4)}\ndef grams(P,k):\n    result=[]\n    for face in S[k]:\n        edges=[sub(P[i],P[face[0]]) for i in face[1:]]\n        result.append(det(mm(edges,tr(edges))))\n    return result\ndef block_diagonal(blocks):\n    n=sum(len(b) for b in blocks);result=[[Q(0)]*n for _ in range(n)];offset=0\n    for b in blocks:\n        for i,row in enumerate(b):\n            for j,v in enumerate(row):result[offset+i][offset+j]=v\n        offset+=len(b)\n    return result\ndef spectrum_check(label,a,values):\n    check(label+' dimension',len(values)==len(a))\n    for eigen,mult in Counter(values).items():\n        shifted=plus(a,diag([-eigen]*len(a)))\n        check(label+' nullity '+str(eigen),len(a)-rank(shifted)==mult)\n\ndef run_case(r,p):\n    r=Q(r);q=r*r;tag=f'r={r}, rule={p}: '\n    if r<=0 or p not in (1,2):raise ValueError('r positive and rule 1 or 2 required')\n    weights=[[Q(1)]*4]\n    for k in range(1,4):weights.append([(x/y)**p for x,y in zip(grams(vertices(r),k),grams(vertices(Q(1)),k))])\n    a=((1+q)/2)**p;b=((2*q+1)/3)**p;c=q**p\n    check(tag+'Gram-derived edge weights',weights[1]==[a,a,Q(1),Q(1),a,a])\n    check(tag+'Gram-derived face/cell weights',weights[2]==[b]*4 and weights[3]==[c])\n    check(tag+'positive weights',all(w>0 for ws in weights for w in ws))\n    H=[diag(ws) for ws in weights];inv=[diag([1/w for w in ws]) for ws in weights]\n    adj={k:mm(mm(inv[k],tr(B[k])),H[k-1]) for k in range(1,4)}\n    for k in range(1,4):check(tag+f'adjoint identity {k}',mm(H[k],adj[k])==mm(tr(B[k]),H[k-1]))\n    check(tag+'upward complex',zero(mm(adj[2],adj[1])) and zero(mm(adj[3],adj[2])))\n    L=[mm(B[1],adj[1]),plus(mm(adj[1],B[1]),mm(B[2],adj[2])),\n       plus(mm(adj[2],B[2]),mm(B[3],adj[3])),mm(adj[3],B[3])]\n    modes0=[4/a,2+2/a,2+2/a]\n    modes2=[4*a/b,2*(a+1)/b,2*(a+1)/b]\n    modes3=[4*b/c]\n    spectra=[[Q(0)]+modes0,modes0+modes2,modes2+modes3,modes3]\n    for k in range(4):\n        check(tag+f'H-self-adjoint L{k}',mm(H[k],L[k])==mm(tr(L[k]),H[k]))\n        spectrum_check(tag+f'L{k}',L[k],spectra[k])\n    A=[[Q(0)]*15 for _ in range(15)];offset=[0,4,10,14]\n    for k in range(1,4):\n        for i,row in enumerate(B[k]):\n            for j,v in enumerate(row):\n                A[offset[k-1]+i][offset[k]+j]=-v\n                A[offset[k]+j][offset[k-1]+i]=adj[k][j][i]\n    totalH=block_diagonal(H)\n    check(tag+'weighted norm conservation',zero(plus(mm(tr(A),totalH),mm(totalH,A))))\n    check(tag+'minus A squared',scale(-1,mm(A,A))==block_diagonal(L))\n    check(tag+'one harmonic dimension',sum(len(z)-rank(z) for z in L)==1)\n    if r==1:check(tag+'regular baseline H=I',totalH==diag([1]*15))\n    return dict(r=r,rule=p,H_diagonals=weights,laplacian_blocks=L,block_spectra=spectra,\n                total_L_trace=sum(sum(L[k][i][i] for i in range(len(L[k]))) for k in range(4)))\n\ndef main():\n    check('boundary chain identities',zero(mm(B[1],B[2])) and zero(mm(B[2],B[3])))\n    cases=[run_case(r,p) for r in ('1/2','1','3/2','2','3') for p in (1,2)]\n    at2={x['rule']:x for x in cases if x['r']==2}\n    check('different spectra at identical geometry',at2[1]['block_spectra'][0]!=at2[2]['block_spectra'][0])\n    check('rule 1 vertex spectrum',at2[1]['block_spectra'][0]==[Q(0),Q(8,5),Q(14,5),Q(14,5)])\n    check('rule 2 vertex spectrum',at2[2]['block_spectra'][0]==[Q(0),Q(16,25),Q(58,25),Q(58,25)])\n    check('not a uniform spectral rescaling',Q(14,5)/Q(8,5)!=Q(58,25)/Q(16,25))\n    report=dict(status='PASS',check_count=len(checks),checks=checks,cases=cases,\n                evidence='EXACT_RATIONAL_CONSTRUCTOR_CHECKS',independent_review=False,\n                empirical_data_used=False,selected_canonical_rule=None,physical_promotion=0)\n    Path(__file__).with_name('EXACT_INTERFACE_RESULTS.json').write_text(json.dumps(encode(report),indent=2)+'\\n')\n    print(f'PASS: {len(checks)} exact checks, {len(cases)} geometry/rule cases; neither rule selected.')\n\nif __name__=='__main__':main()\n"
