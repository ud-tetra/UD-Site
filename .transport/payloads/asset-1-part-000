    "content": "Exact arithmetic on exported decimal tables; does not authorize K-minus continuation. #!/usr/bin/env python3\n\"\"\"Prospective Stage 0 extraction and arithmetic only; no hardware authorization.\"\"\"\nimport argparse\nimport csv\nimport hashlib\nimport json\nfrom decimal import Decimal, localcontext\nfrom fractions import Fraction\nfrom pathlib import Path\n\nMODES = ('u1', 'u2', 'u3')\n\ndef rational(x):\n    if isinstance(x, bool) or x is None:\n        raise ValueError('Expected a finite decimal number')\n    try:\n        value = Decimal(str(x))\n        if not value.is_finite():\n            raise ValueError('Nonfinite value')\n        return Fraction(value)\n    except (ArithmeticError, ValueError) as exc:\n        raise ValueError('Expected a finite decimal number') from exc\n\ndef show(x):\n    with localcontext() as ctx:\n        ctx.prec = 28\n        return str(Decimal(x.numerator) / Decimal(x.denominator))\n\ndef exact(x):\n    return {'numerator': x.numerator, 'denominator': x.denominator,\n            'decimal_display': show(x)}\n\ndef peak(rows):\n    if len(rows) != 401:\n        raise ValueError('Expected 401 sweep points')\n    fs = [rational(r['f_hz']) for r in rows]\n    ys = [rational(r['amplitude_v_rms']) for r in rows]\n    if fs != [Fraction(8000 + 10*k) for k in range(401)]:\n        raise ValueError('Grid must be ordered 8000:10:12000 Hz')\n    if min(ys) < 0:\n        raise ValueError('Negative amplitude')\n    top = max(ys)\n    if ys.count(top) != 1:\n        raise ValueError('Largest amplitude is tied')\n    k = ys.index(top)\n    if k in (0, 400):\n        raise ValueError('Largest amplitude is at band endpoint')\n    ym, y0, yp = ys[k-1:k+2]\n    if not (y0 > ym and y0 > yp):\n        raise ValueError('Peak is not strict')\n    d = ym - 2*y0 + yp\n    offset = (ym-yp)/(2*d)\n    if d >= 0 or abs(offset) >= Fraction(1, 2):\n        raise ValueError('Invalid parabolic interpolation')\n    return fs[k] + 10*offset, k\n\ndef gate(fs):\n    if len(fs) != 3 or any(f < 8000 or f > 12000 for f in fs):\n        raise ValueError('Expected three in-band positive frequencies')\n    delta = (max(fs)-min(fs))/(sum(fs)/3)\n    return {'delta4': exact(delta), 'threshold': '0.015',\n            'arithmetic_gate': 'STAGE0_PASS' if delta <= Fraction(3, 200) else 'STAGE0_FAIL',\n            'execution_status': 'PROVENANCE_AND_PREREQUISITES_NOT_VERIFIED',\n            'kminus_continuation_authorized_by_this_tool': False,\n            'physical_promotion': 0}\n\ndef score_template(obj):\n    rows = obj.get('measurements', [])\n    if len(rows) != 3 or [r.get('mode') for r in rows] != list(MODES):\n        raise ValueError('Require exactly u1, u2, u3 in order')\n    if obj.get('frequency_unit') != 'Hz':\n        raise ValueError('Frequency unit must be Hz')\n    if any(r.get('frequency_hz') is None for r in rows):\n        return {'arithmetic_gate': 'UNSCORED', 'reason': 'Missing measured frequencies',\n                'kminus_continuation_authorized_by_this_tool': False, 'physical_promotion': 0}\n    return gate([rational(r['frequency_hz']) for r in rows])\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    sub = parser.add_subparsers(dest='command', required=True)\n    p = sub.add_parser('extract')\n    p.add_argument('csvs', nargs=3, help='u1.csv u2.csv u3.csv, in that order')\n    p = sub.add_parser('score')\n    p.add_argument('result_json')\n    args = parser.parse_args()\n    try:\n        if args.command == 'score':\n            obj = json.loads(Path(args.result_json).read_text(), parse_float=Decimal)\n            result = score_template(obj)\n        else:\n            measurements, values = [], []\n            for mode, name in zip(MODES, args.csvs):\n                path = Path(name)\n                with path.open(newline='') as handle:\n                    reader = csv.DictReader(handle)\n                    if reader.fieldnames != ['f_hz', 'amplitude_v_rms']:\n                        raise ValueError('CSV header must be f_hz,amplitude_v_rms')\n                    rows = list(reader)\n                if any(set(r) != {'f_hz', 'amplitude_v_rms'} for r in rows):\n                    raise ValueError('Malformed CSV row')\n                f, k = peak(rows)\n                values.append(f)\n                measurements.append({'mode': mode, 'frequency_hz_exact': exact(f),\n                    'peak_grid_index': k, 'csv_file': path.name,\n                    'csv_sha256': hashlib.sha256(path.read_bytes()).hexdigest()})\n            result = {'frequency_unit': 'Hz', 'measurements': measurements, **gate(values)}\n    except (ValueError, KeyError, TypeError, OSError, csv.Error) as exc:\n        result = {'arithmetic_gate': 'INVALID_ACQUISITION', 'reason': str(exc),\n                  'kminus_continuation_authorized_by_this_tool': False, 'physical_promotion': 0}\n    print(json.dumps(result, indent=2))\n    return 0 if result['arithmetic_gate'] == 'STAGE0_PASS' else 1\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"
