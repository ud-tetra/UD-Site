e,'empirical_data_used':False,'physical_promotion':0}\n    Path(__file__).with_name('EXACT_SHAPE_RESULTS.json').write_text(json.dumps(encode(report),indent=2)+'\\n')\n    print(f'PASS: {len(checks)} exact checks; {len(cases)} rational geometries; no empirical data.')\n\nif __name__=='__main__':main()\n"
