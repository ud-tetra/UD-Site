    "content": "Read with the event-exchange and parity review. Original status labels are retained; templates and symbolic controls are not acquired data. #!/usr/bin/env python3\n\"\"\"\nUD gate->burden v0.2 analyzer.\nPrimary identification uses matched TREAT-CTRL attributable receipts.\nNo theory targets embedded.\n\"\"\"\nimport csv, sys\nfrom collections import defaultdict\n\ndef num(x):\n    return None if x in (\"\",None) else float(x)\n\ndef diff(t,c,key):\n    a,b=num(t.get(key)),num(c.get(key))\n    return None if a is None or b is None else a-b\n\ndef slope(xs,ys):\n    den=sum(x*x for x in xs)\n    if den==0: return None\n    return sum(x*y for x,y in zip(xs,ys))/den\n\nif __name__==\"__main__\":\n    if len(sys.argv)!=2:\n        raise SystemExit(\"usage: analyzer.py telemetry.csv\")\n    rows=list(csv.DictReader(open(sys.argv[1],newline=\"\",encoding=\"utf-8\")))\n    pairs=defaultdict(dict)\n    for r in rows:\n        pairs[r[\"pair_id\"]][r[\"run_role\"]]=r\n\n    derived=defaultdict(list)\n    for pid,p in pairs.items():\n        if not {\"TREAT\",\"CTRL\"} <= set(p): continue\n        t,c=p[\"TREAT\"],p[\"CTRL\"]\n        cls=t[\"event_class\"]\n        dHs=diff(t,c,\"delta_H_S\")\n        dq={i:diff(t,c,f\"delta_q{i}\") for i in range(4)}\n        if dHs is None or any(v is None for v in dq.values()): continue\n        if cls==\"U\": derived[\"m0\"].append((dq[0],-2*dHs))\n        elif cls==\"C1\": derived[\"mperp1\"].append((dq[1],-2*dHs))\n        elif cls==\"C2\": derived[\"mperp2\"].append((dq[2],-2*dHs))\n        elif cls==\"C3\": derived[\"mperp3\"].append((dq[3],-2*dHs))\n\n    for key,pts in derived.items():\n        xs=[p[0] for p in pts]; ys=[p[1] for p in pts]\n        print(key, slope(xs,ys), \"n=\",len(pts))\n"
