    "content": "Replays the finite certificates; universal sign proofs are in the note. \"\"\"Exact certificates for one frozen labeled move; witnesses are not jump laws.\"\"\"\nfrom pathlib import Path\nimport csv, json, hashlib\nimport sympy as s\nR=Path(__file__).resolve().parent\ncat=json.loads((R/'source/MATRIX_CATALOG.json').read_text())\ndef read(n):\n with (R/'source'/f'{n}.csv').open() as f:return s.Matrix([[s.Rational(x) for x in row] for row in csv.reader(f)])\nDm,Dp=read('D_minus'),read('D_plus')\nbm,bp=[cat[n]['row_basis'] for n in ['D_minus','D_plus']]\ncommon=sorted(set(bm)&set(bp),key=lambda x:(len(x),x))\ndef unit(b,label):\n v=s.zeros(len(b),1);v[b.index(label)]=1;return v\ndef zero(M):return all(s.simplify(x)==0 for x in M)\ndef eq(A,B):assert zero(A-B)\ntm=unit(bm,'0123')-unit(bm,'0124')\ntp=-unit(bp,'0134')+unit(bp,'0234')-unit(bp,'1234')\noverlap=s.Matrix([[int(a==b) for a in bm] for b in bp])\neq(Dp*tp,overlap*Dm*tm)\nassert (tm.T*tm)[0]==2 and (tp.T*tp)[0]==3\nassert Dm.rank()==11 and Dp.rank()==13\nassert len(common)==20\n\n# The whole degree-preserving chain-map space: 184 variables, rank 88.\nvariables=[(i,j) for i,a in enumerate(bp) for j,b in enumerate(bm) if len(a)==len(b)]\nidx={p:k for k,p in enumerate(variables)};rows=[]\nfor i in range(27):\n for j in range(23):\n  row=[0]*len(variables)\n  for k in range(27):\n   if (k,j) in idx:row[idx[k,j]]+=Dp[i,k]\n  for k in range(23):\n   if (i,k) in idx:row[idx[i,k]]-=Dm[k,j]\n  if any(row):rows.append(row)\nconstraint=s.Matrix(rows);assert len(variables)==184 and constraint.rank()==88\n\n# All boundary-fixing chain maps parameterized by w in C3(K+).\ns3=unit(bp,'123')-unit(bp,'023')+unit(bp,'013')\ntops=[a for a in bp if len(a)==4]\ndef family(w):\n J=overlap.copy()\n J[:,bm.index('012')]=s3-Dp*w\n J[:,bm.index('0123')]=w\n J[:,bm.index('0124')]=w-tp\n return J\nJ0=family(s.zeros(27,1));directions=[family(unit(bp,a))-J0 for a in tops]\neq(Dp*J0,J0*Dm);eq(J0*tm,tp)\nfor H in directions:eq(Dp*H,H*Dm)\nassert s.Matrix.hstack(*[H.reshape(621,1) for H in directions]).rank()==3\n\n# A graded coordinate isometry preserving every common coordinate/receipt.\nE=overlap.copy()\nfor old,new in [('012','034'),('0123','0134'),('0124','0234')]:\n E[bp.index(new),bm.index(old)]=1\neq(E.T*E,s.eye(23));assert not zero(Dp*E-E*Dm)\n\n# Exact singular pairs (x,y), D y = sqrt(lambda) x, D x = 0.\ndef pairs(D,b):\n result={}\n for k in [1,2,3]:\n  low=[i for i,c in enumerate(b) if len(c)==k]\n  high=[i for i,c in enumerate(b) if len(c)==k+1]\n  B=D.extract(low,high);result[k]={}\n  for lam,mult,vs in (B.T*B).eigenvects():\n   if lam==0:continue\n   result[k][int(lam)]=[]\n   for u in s.GramSchmidt(vs,True):\n    y=s.zeros(len(b),1);x=s.zeros(len(b),1)\n    for i,v in zip(high,u):y[i]=v\n    for i,v in zip(low,B*u/s.sqrt(lam)):x[i]=s.simplify(v)\n    result[k][int(lam)].append((x,y))\n return result\npm,pp=pairs(Dm,bm),pairs(Dp,bp)\ndef mix(p2,p5):\n x2,y2=p2;x5,y5=p5\n x=s.Rational(2,3)*x2+s.sqrt(5)/3*x5\n y=s.sqrt(s.Rational(2,3))*y2+y5/s.sqrt(3)\n z=-s.sqrt(5)/3*x2+s.Rational(2,3)*x5\n return (x,y),z\ndef dilute(p5,z):\n x,y=p5\n return x,s.sqrt(s.Rational(3,5))*y+s.sqrt(s.Rational(2,5))*z\np3,z2=mix(pp[3][2][0],pp[3][5][0])\np2,z1=mix(pp[2][2][0],pp[2][5][0])\ntarget={3:{3:[p3],5:pp[3][5][1:]},\n        2:{3:[p2,dilute(pp[2][5][1],z2)],5:pp[2][5][2:]},\n        1:{3:[dilute(pp[1][5][0],z1)],5:pp[1][5][1:]}}\ndef harmonic(b):\n return sum((unit(b,str(i)) for i in range(5)),s.zeros(len(b),1))/s.sqrt(5)\nsrc=[harmonic(bm)];dst=[harmonic(bp)]\nfor k in [1,2,3]:\n for lam in sorted(pm[k]):\n  assert len(pm[k][lam])==len(target[k][lam])\n  for (x,y),(u,v) in zip(pm[k][lam],target[k][lam]):\n   src.extend([x,y]);dst.extend([u,v])\n   eq(Dp*v,s.sqrt(lam)*u);eq(Dp*u,s.zeros(27,1))\nS=s.Matrix.hstack(*src);T=s.Matrix.hstack(*dst)\neq(S.T*S,s.eye(23));eq(T.T*T,s.eye(23))\nJ=(T*S.T).applyfunc(s.simplify)\neq(J.T*J,s.eye(23));eq(Dp*J,J*Dm)\nassert all(J[i,j]==0 for i,a in enumerate(bp) for j,b in enumerate(bm) if len(a)!=len(b))\nassert any(not zero(J*unit(bm,c)-unit(bp,c)) for c in common)\n\n# Sign/receipt obstruction coefficient: none of the new faces contains edge 01.\nassert all(Dp[bp.index('01'),bp.index(c)]==0 for c in ['034','134','234'])\nassert Dm[bm.index('01'),bm.index('012')]==1\n# Minimal-norm filling of the old triangle in K+: six half-weight faces.\ny0=(unit(bp,'013')+unit(bp,'014')-unit(bp,'023')-unit(bp,'024')+unit(bp,'123')+unit(bp,'124'))/2\nb012=overlap*Dm*unit(bm,'012')\neq(Dp*y0,b012);assert (y0.T*y0)[0]==s.Rational(3,2)\nBp2=Dp[5:15,15:24]\nassert all((y0[15:24,0].T*v)[0]==0 for v in Bp2.nullspace())\nfor name,M in [('chain_isometry_existence_witness',J),('isometry_boundary_receipt_existence_witness',E),('boundary_chain_affine_origin',J0)]:\n with (R/(name+'.csv')).open('w',newline='') as f:csv.writer(f).writerows(M.tolist())\nresults={'source':'frozen labeled 2-to-3 pair, unit simplex inner products',\n 'graded_chain_map_variables':184,'constraint_rank':88,'graded_chain_map_dimension':96,\n 'ungraded_intertwiner_dimension':2*11*13+11+13+1,\n 'boundary_fixing_chain_map_affine_dimension':3,\n 'filling_norm_squares':{'minus':2,'plus':3},\n 'minimum_plus_filling_norm_square_for_boundary_012':'3/2',\n 'chain_and_isometry':'NONEMPTY: exact algebraic witness checked',\n 'chain_and_boundary_identity':'NONEMPTY: complete affine family',\n 'chain_isometry_boundary_identity':'EMPTY: filling norm obstruction',\n 'chain_and_universal_common_incidence_signs':'EMPTY: edge 01 / face 012 obstruction',\n 'chain_and_vertex_edge_signs_or_receipts':'NONEMPTY: boundary-fixing affine family',\n 'chain_isometry_vertex_edge_signs_or_receipts':'EMPTY: minimum triangle filling norm 3/2 > 1',\n 'isometry_boundary_signs_and_exact_common_receipts':'NONEMPTY: coordinate injection witness',\n 'witness_status':'existence certificates only; no jump law selected',\n 'physical_promotion':0,'sympy_version':s.__version__}\n(R/'EXACT_RESULTS.json').write_text(json.dumps(results,indent=2)+'\\n')\nprint(json.dumps(results))\n"
