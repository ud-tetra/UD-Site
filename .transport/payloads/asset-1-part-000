    "content": "Run within the complete package with its dependencies. #!/usr/bin/env python3\n\"\"\"Exact finite replay of the shape audit. No empirical data or physical scoring.\"\"\"\nfrom fractions import Fraction as Q\nfrom itertools import combinations, permutations\nfrom pathlib import Path\nimport json\n\nchecks = []\ndef check(label, condition):\n    if not condition: raise AssertionError(label)\n    checks.append(label)\ndef sub(a,b): return [x-y for x,y in zip(a,b)]\ndef dot(a,b): return sum(x*y for x,y in zip(a,b))\ndef cross(a,b): return [a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]]\ndef tr(a): return [list(v) for v in zip(*a)]\ndef mm(a,b): return [[dot(row,col) for col in tr(b)] for row in a]\ndef plus(a,b): return [[x+y for x,y in zip(u,v)] for u,v in zip(a,b)]\ndef scale(c,a): return [[c*x for x in row] for row in a]\ndef diag(xs): return [[v if i==j else Q(0) for j in range(len(xs))] for i,v in enumerate(xs)]\ndef zero(a): return all(x==0 for row in a for x in row)\ndef encode(obj):\n    if isinstance(obj,Q): return str(obj)\n    if isinstance(obj,dict): return {str(k):encode(v) for k,v in obj.items()}\n    if isinstance(obj,(tuple,list)): return [encode(x) for x in obj]\n    return obj\n\ndef geometry(r):\n    r=Q(r)\n    if r<=0: raise ValueError('Nondegenerate family requires r > 0')\n    q=r*r; D=2*q+1\n    P=[[Q(1),Q(1),r],[Q(1),Q(-1),-r],[Q(-1),Q(1),-r],[Q(-1),Q(-1),r]]\n    M=[[-x*r,-y*r,-z/r] for x,y,z in P]\n    distances={(i,j):dot(sub(P[i],P[j]),sub(P[i],P[j])) for i,j in combinations(range(4),2)}\n    tag=f'r={r} '\n    check(tag+'squared edges',all(v==(8 if (i,j) in ((0,3),(1,2)) else 4*(1+q)) for (i,j),v in distances.items()))\n    crosses=[]\n    for i in range(4):\n        a,b,c=[P[j] for j in range(4) if j!=i]\n        v=cross(sub(b,a),sub(c,a))\n        if dot(v,sub(P[i],a))>0: v=[-x for x in v]\n        crosses.append(v)\n        check(tag+f'face {i}: outward normal from cross product',v==[4*x for x in M[i]])\n   