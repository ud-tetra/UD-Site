    "content": "Run within the complete package with its dependencies. #!/usr/bin/env python3\n\"\"\"Exact finite checks for the declared diagonal-support contract; not empirical data.\"\"\"\nimport json, sys\nfrom pathlib import Path\nfrom itertools import combinations\nsys.path.insert(0, str(Path(__file__).parent/'dependencies'))\nfrom shape_helpers import Q, mm, tr, plus, scale, diag, zero, boundary, encode\nchecks=[]\ndef check(label, condition):\n    if not condition: raise AssertionError(label)\n    checks.append(label)\ndef rank(a):\n    a=[[Q(x) for x in row] for row in a]; i=0\n    for j in range(len(a[0])):\n        p=next((k for k in range(i,len(a)) if a[k][j]),None)\n        if p is None: continue\n        a[i],a[p]=a[p],a[i]; v=a[i][j]; a[i]=[x/v for x in a[i]]\n        for k in range(len(a)):\n            if k!=i:\n                f=a[k][j]; a[k]=[x-f*y for x,y in zip(a[k],a[i])]\n        i+=1\n        if i==len(a): break\n    return i\nS={k:list(combinations(range(4),k+1)) for k in range(4)}\noff=[0,4,10,14]; n=15\nB=[[Q(0)]*n for _ in range(n)]\nfor k in range(1,4):\n    for i,row in enumerate(boundary(k,S)):\n        for j,v in enumerate(row): B[off[k-1]+i][off[k]+j]=Q(v)\nedges=[(i,j,B[i][j]) for i in range(n) for j in range(n) if B[i][j]]\nA0=plus(tr(B),scale(-1,B))\ndef mv(a,c):return [sum(x*y for x,y in zip(row,c)) for row in a]\ndef sign(x): return (x>0)-(x<0)\ndef receipt(c,h):\n    stock=[w*x*x for w,x in zip(h,c)]; total=sum(stock)\n    if total<=0:raise ValueError('zero state has no normalized receipt')\n    p=[x/total for x in stock]\n    currents={(i,j):2*b*h[i]*c[i]*c[j] for i,j,b in edges}\n    adj={i:[] for i in range(n) if stock[i]}\n    for i,j,b in edges:\n        if i in adj and j in adj:\n            chi=sign(b*currents[i,j]); adj[i].append((j,chi));adj[j].append((i,chi))\n    signs={}; roots=[]; forest=[]\n    for root in sorted(adj):\n        if root in signs:continue\n        roots.append(root);signs[root]=sign(c[root]);queue=[root]\n        for i in queue:\n            for j,chi in sorted(adj[i]):\n                if j not in signs:\n                    signs[j]=signs[i]*chi;forest.append((i,j));queue.append(j)\n    return stock,total,p,currents,signs,roots,forest\n\ndef main():\n    check('boundary squares to zero',zero(mm(B,B)))\n    check('filled tetrahedron has 28 incidences',len(edges)==28)\n    constraints=[]\n    for i,j,b in edges:\n        row=[Q(0)]*n;row[i]=1;row[j]=-1;constraints.append(row)\n    check('diagonal invariant constraint rank 14',rank(constraints)==14)\n    L=scale(-1,mm(A0,A0)); Hcross=plus(diag([Q(1)]*n),L)\n    check('non-diagonal conserved form exists',not zero([[Hcross[i][j] if i!=j else 0 for j in range(n)] for i in range(n)]))\n    check('non-diagonal conserved form identity',zero(plus(mm(tr(A0),Hcross),mm(Hcross,A0))))\n    cases=[]\n    for r in map(Q,['1/2','1','3/2','2','3']):\n        for power in (1,2):\n            q=r*r;a=((1+q)/2)**power;b=((2*q+1)/3)**power;d=q**power\n            h=[Q(1)]*4+[a,a,Q(1),Q(1),a,a]+[b]*4+[d]\n            H=diag(h);A=plus(mm(mm(diag([1/x for x in h]),tr(B)),H),scale(-1,B))\n            tag=f'r={r}, rule={power}: '\n            check(tag+'weighted skew identity',zero(plus(mm(tr(A),H),mm(H,A))))\n            check(tag+'old generator preserves H iff regular',zero(plus(mm(tr(A0),H),mm(H,A0)))==(r==1))\n            states=[[Q((-1)**i*(i+1)) for i in range(n)],\n                    [Q(2),Q(0),Q(0),Q(0),Q(-3)]+[Q(0)]*10,\n                    [Q(2),Q(-3)]+[Q(0)]*13]\n            for si,c in enumerate(states):\n                st,total,p,J,sg,roots,forest=receipt(c,h);dc=mv(A,c)\n                continuity=[Q(0)]*n\n                for i,j,v in edges:continuity[i]-=J[i,j];continuity[j]+=J[i,j]\n                check(tag+f'state {si} local balance',continuity==[2*h[i]*c[i]*dc[i] for i in range(n)])\n                check(tag+f'state {si} global balance',sum(continuity)==0)\n                check(tag+f'state {si} squared reconstruction',all(p[i]/h[i]==c[i]*c[i]/total for i in range(n)))\n                check(tag+f'state {si} forest sign reconstruction',all(sg.get(i,0)==sign(c[i]) for i in range(n)))\n                check(tag+f'state {si} current consistency',all((J[i,j]/total)**2==4*h[i]/h[j]*p[i]*p[j] for i,j,_ in edges))\n                check(tag+f'state {si} forest size',len(forest)==len(sg)-len(roots))\n                if si==2:check(tag+'disconnected support requires two roots',len(roots)==2)\n            cases.append({'r':r,'rule':power,'weights':h})\n    h=[Q(1)]*4+[Q(5,2),Q(5,2),Q(1),Q(1),Q(5,2),Q(5,2)]+[Q(3)]*4+[Q(4)]\n    c=[Q(2)]+[Q(0)]*3+[Q(-3)]+[Q(0)]*10\n    st,total,p,J,sg,roots,forest=receipt(c,h)\n    check('legacy current equation rejected at r=2',J[0,4]**2!=4*st[0]*st[4])\n    derivative=sum(2*h[i]*c[i]*mv(A0,c)[i] for i in range(n))\n    check('old source explicit support drift',derivative==18)\n    try:receipt([Q(0)]*n,h)\n    except ValueError:check('zero state rejected',True)\n    else:check('zero state rejected',False)\n    report={'status':'PASS','check_count':len(checks),'checks':checks,'cases':cases,\n        'counterexample':{'support':total,'current_0_01':J[0,4],'current_squared':J[0,4]**2,\n            'legacy_4_stock_product':4*st[0]*st[4],'old_source_support_derivative':derivative},\n        'evidence':'EXACT_RATIONAL_CONSTRUCTOR_CHECKS','independent_review':False,\n        'physical_promotion':0,'empirical_data_used':False,'canonical_shape_rule_selected':False}\n    Path(__file__).with_name('EXACT_RECEIPT_RESULTS.json').write_text(json.dumps(encode(report),indent=2)+'\\n')\n    print(f'PASS: {len(checks)} exact checks; 10 shape/rule cases, 3 support patterns each.')\nif __name__=='__main__':main()\n"
