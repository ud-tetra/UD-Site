    "content": "Run within the complete package with its dependencies. #!/usr/bin/env python3\n\"\"\"Exact rational coordinate-contract checks; synthetic basis scales, no measurements.\"\"\"\nfrom pathlib import Path\nfrom itertools import combinations\nfrom fractions import Fraction as Q\nimport sys,json\nsys.path.insert(0,str(Path(__file__).parent/'dependencies'))\nfrom shape_helpers import mm,tr,plus,scale,diag,zero,boundary,encode\nchecks=[]\ndef check(label,x):\n    if not x:raise AssertionError(label)\n    checks.append(label)\ndef mv(M,x):return [sum(a*b for a,b in zip(row,x)) for row in M]\ndef inverse(M):\n    n=len(M);a=[list(row)+[Q(i==j) for j in range(n)] for i,row in enumerate(M)]\n    for j in range(n):\n        p=next(k for k in range(j,n) if a[k][j]);a[j],a[p]=a[p],a[j]\n        v=a[j][j];a[j]=[x/v for x in a[j]]\n        for k in range(n):\n            if k!=j:\n                f=a[k][j];a[k]=[x-f*y for x,y in zip(a[k],a[j])]\n    return [row[n:] for row in a]\ndef minus(a,b):return plus(a,scale(-1,b))\nS={k:list(combinations(range(4),k+1)) for k in range(4)}\nn=15;offset=[0,4,10,14];I=diag([Q(1)]*n)\nB=[[Q(0)]*n for _ in range(n)]\nfor k in range(1,4):\n    for i,row in enumerate(boundary(k,S)):\n        for j,x in enumerate(row):B[offset[k-1]+i][offset[k]+j]=Q(x)\nA=minus(tr(B),B);edges=[(i,j,B[i][j]) for i in range(n) for j in range(n) if B[i][j]]\ndef conjugate(A,d):return mm(mm(diag([1/x for x in d]),A),diag(d))\ndef run():\n    check('boundary nilpotency',zero(mm(B,B)))\n    check('source skew',zero(plus(tr(A),A)))\n    check('filled-tet minimal polynomial',zero(plus(mm(mm(A,A),A),scale(4,A))))\n    # A Cayley transform is an exact orthogonal test step; NOT an exact-time exponential.\n    t=Q(1,5);U=mm(inverse(minus(I,scale(t,A))),plus(I,scale(t,A)))\n    check('exact rational orthogonal test step',mm(tr(U),U)==I)\n    scales=[[Q(1)]*n,[Q(1)]*4+[Q(i+2,3) for i in range(11)],\n            [Q(i+1,5) for i in range(n)]]\n    a=[Q((-1)**i*(i+1),7) for i in range(n)]\n    total=sum(x*x for x in a);records=[]\n    for k,d in enumerate(scales):\n        tag=f'basis case {k}: ';v=[x*x for x in d];V=diag(v);Vi=diag([1/x for x in v])\n        R=conjugate(A,d);M=conjugate(A,[1/x for x in d]);Br=conjugate(B,d)\n        rho=[x/y for x,y in zip(a,d)];m=[x*y for x,y in zip(a,d)]\n        check(tag+'coordinate identity',m==mv(V,rho))\n        check(tag+'three equal supports',sum(v[i]*rho[i]**2 for i in range(n))==total==sum(m[i]**2/v[i] for i in range(n)))\n        check(tag+'density weighted skew',zero(plus(mm(tr(R),V),mm(V,R))))\n        check(tag+'integral weighted skew',zero(plus(mm(tr(M),Vi),mm(Vi,M))))\n        check(tag+'coordinate conjugacy',M==mm(mm(V,R),Vi))\n        check(tag+'transformed boundary nilpotency',zero(mm(Br,Br)))\n        check(tag+'transformed adjoint generator',R==minus(mm(mm(Vi,tr(Br)),V),Br))\n        check(tag+'same minimal polynomial',zero(plus(mm(mm(R,R),R),scale(4,R))))\n        check(tag+'same squared-generator trace',sum(mm(R,R)[i][i] for i in range(n))==-56)\n        for label,c,h,gen,dd in [('density',rho,v,R,d),('integral',m,[1/x for x in v],M,[1/x for x in d])]:\n            currents=[2*b*dd[i]*dd[j]*c[i]*c[j] for i,j,b in edges]\n            check(tag+label+' currents unchanged',currents==[2*b*a[i]*a[j] for i,j,b in edges])\n            dr=mv(gen,c);balance=[Q(0)]*n\n            for (i,j,b),flow in zip(edges,currents):balance[i]-=flow;balance[j]+=flow\n            check(tag+label+' local continuity',balance==[2*h[i]*c[i]*dr[i] for i in range(n)])\n            check(tag+label+' current consistency',all(flow**2==4*h[i]*c[i]**2*h[j]*c[j]**2 for (i,j,b),flow in zip(edges,currents)))\n            step=conjugate(U,dd);new=mv(step,c)\n            check(tag+label+' finite-step intertwining',mv(diag(dd),new)==mv(U,a))\n            check(tag+label+' finite-step support',sum(h[i]*new[i]**2 for i in range(n))==total)\n        # d' is an arbitrary local coordinate-scale velocity, not a shape evolution law.\n        dprime=[Q((-1)**i,11) for i in range(n)];g=[x/y for x,y in zip(dprime,d)]\n        Vdot=diag([2*d[i]*dprime[i] for i in range(n)])\n        Rmoving=minus(R,diag(g));Mmoving=plus(M,diag(g))\n        check(tag+'moving density conservation',zero(plus(plus(mm(tr(Rmoving),V),mm(V,Rmoving)),Vdot)))\n        Vidot=diag([-2*dprime[i]/d[i]**3 for i in range(n)])\n        check(tag+'moving integral conservation',zero(plus(plus(mm(tr(Mmoving),Vi),mm(Vi,Mmoving)),Vidot)))\n        check(tag+'moving coordinate relation',Mmoving==plus(mm(mm(V,Rmoving),Vi),mm(Vdot,Vi)))\n        fixed=minus(mm(mm(Vi,tr(B)),V),B)\n        check(tag+'fixed B differs except unit case',(fixed==R)==(k==0))\n        records.append({'case':k,'sqrt_volume_ratios':d,'volume_ratios':v,'interpretation':'synthetic positive coordinate scales; not claimed tetrahedron geometry'})\n    d0,d1,d2=scales\n    T01=diag([a/b for a,b in zip(d0,d1)]);T12=diag([a/b for a,b in zip(d1,d2)]);T20=diag([a/b for a,b in zip(d2,d0)])\n    check('pure coordinate roundtrip identity',mm(mm(T20,T12),T01)==I)\n    check('density support preserving expansion changes integral',Q(4)*Q(1,2)==2)\n    check('integral preserving expansion changes squared support',Q(4)*Q(1,4)**2==Q(1,4))\n    # These are squared actual measure ratios from the exact disphenoid family.\n    geometry=[]\n    for r in map(Q,['1/2','1','2','3']):\n        q=r*r;e=(1+q)/2;f=(2*q+1)/3\n        check(f'r={r}: positive geometric measures',min(e,f,q)>0)\n        check(f'r={r}: regular reference iff r=1',(e==f==q==1)==(r==1))\n        geometry.append({'r':r,'edge_03_12_ratio_squared':Q(1),'other_edge_ratio_squared':e,'face_ratio_squared':f,'cell_ratio':r})\n    for ell in map(Q,['1/2','1','5/2']):\n        W=[[Q(0)]*4 for _ in range(4)]\n        for i,j in combinations(range(4),2):\n            w=Q(1) if (i,j) in ((0,3),(1,2)) else 1/ell\n            W[i][i]+=w;W[j][j]+=w;W[i][j]-=w;W[j][i]-=w\n        modes=[([1,1,1,1],Q(0)),([1,-1,-1,1],4/ell),([1,0,0,-1],2+2/ell),([0,1,-1,0],2+2/ell)]\n        for j,(vector,value) in enumerate(modes):\n            check(f'weighted vertex mode ell={ell}, branch={j}',mv(W,vector)==[value*x for x in vector])\n    report={'status':'PASS','check_count':len(checks),'checks':checks,'coordinate_cases':records,'disphenoid_measure_data':geometry,\n            'physical_promotion':0,'canonical_rule_selected':False,'empirical_data_used':False,'independent_review':False,\n            'finite_test_step':'Cayley transform, not exact exponential at a claimed time'}\n    Path(__file__).with_name('EXACT_CONTRACT_RESULTS.json').write_text(json.dumps(encode(report),indent=2)+'\\n')\n    print(f'PASS: {len(checks)} exact rational checks; 3 coordinate cases and 4 disphenoid measure cases.')\nif __name__=='__main__':run()\n"
