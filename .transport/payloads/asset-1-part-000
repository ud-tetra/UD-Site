range(offset,offset+d)))\n        offset += d\n    regions += [set(range(n//2)), {0,n-1}]\n    for region in regions:\n        require(quadratic_coefficients(A,region)==cut_coefficients(A,region),\n                'polynomial cut identity failed')\n    return len(regions)\n\ndef main():\n    require(__debug__, 'Run without -O: historical verifier uses assertions')\n    cases = {'A':v.K_MINUS,\n             'B':[(0,1,2,3),(0,1,2,4),(0,1,3,4)],\n             'C':v.K_PLUS}\n    expected = {'A':([5,9,7,2],{0:1,3:8,5:14}),\n                'B':([5,10,9,3],{0:1,2:4,5:22}),\n                'C':([5,10,9,3],{0:1,2:4,5:22})}\n    results = {}\n    matrices = {}\n    for name,tets in cases.items():\n        result = v.verify(name,tets)\n        require(result['dims']==expected[name][0], 'unexpected simplex count')\n        require(result['laplacian_spectrum']==expected[name][1], 'spectrum mismatch')\n        simplices,dims,boundaries,A = assemble(tets)\n        result['polynomial_cut_regions_checked'] = check_continuity(A,dims)\n        result['arbitrary_real_amplitude_identity'] = 'PASS within the tested regions'\n        results[name] = result\n        matrices[name] = {'simplices':simplices,\n                          'boundaries':[[[int(x) for x in row] for row in b] for b in boundaries],\n                          'skew_operator':[[int(x) for x in row] for row in A]}\n\n    simplices,dims,boundaries,A = assemble(cases['A'])\n    mask_count = 0\n    for mask in range(1 << dims[2]):\n        gated = [[x for x in row] for row in boundaries[2]]\n        for f in range(dims[2]):\n            if not ((mask >> f) & 1):\n                gated[f] = [Q(0) for _ in gated[f]]\n        Ag = v.block_operator(boundaries[:2]+[gated],dims,True)\n        check_continuity(Ag,dims)\n        mask_count += 1\n    # Frozen face gates preserve skew symmetry. No gate-transition law is inferred.\n\n    broken = [row[:] for row in A]\n    edge = dims[0]\n    require(broken[0][edge] != 0,'mutation 